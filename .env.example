# Copie este arquivo para ".env" e preencha com seus dados reais.
# O arquivo .env NUNCA deve ser compartilhado publicamente (contém senhas).

# Chave secreta da aplicação (use uma string aleatória e longa em produção)
SECRET_KEY=troque-esta-chave-por-uma-bem-aleatoria

# --- Banco de dados PostgreSQL ---
# Opção A) Defina os campos separados abaixo (mais simples para uso local):
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chamado

# Opção B) OU defina a URL completa de conexão (tem prioridade sobre os campos acima).
# Útil para serviços gerenciados como Render, Railway, Supabase, Heroku, RDS etc.
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# --- Configuração de e-mail (SMTP) ---
# Defina MAIL_ATIVO=True para habilitar o envio real de notificações.
# Enquanto estiver False, os e-mails só serão exibidos no console (modo teste).
MAIL_ATIVO=False

# Exemplo usando Gmail (é necessário criar uma "senha de app" no Google,
# não use a senha normal da conta):
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=sua-senha-de-app
MAIL_DEFAULT_SENDER=seuemail@gmail.com

# Exemplo usando Outlook/Office365:
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USE_TLS=True

# Exemplo usando SendGrid:
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=sua-api-key-do-sendgrid
