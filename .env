# Chave secreta da aplicação (use uma string aleatória e longa em produção)
SECRET_KEY=troque-esta-chave-por-uma-bem-aleatoria

# --- Configuração de e-mail (SMTP) ---
# Defina MAIL_ATIVO=True para habilitar o envio real de notificações.
# Enquanto estiver False, os e-mails só serão exibidos no console (modo teste).
MAIL_ATIVO=True

# Exemplo usando Gmail (é necessário criar uma "senha de app" no Google,
# não use a senha normal da conta):
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=False
